# ---- Arc testnet (chain 5042002) ----
NEXT_PUBLIC_ROTA_ADDRESS=0xe0b354e9251d81ce957262db1c93e9c56f85b3ba
NEXT_PUBLIC_ROTA_DEPLOY_BLOCK=63651642

# ---- Arc mainnet (chain 5042) ----
NEXT_PUBLIC_ROTA_ADDRESS_MAINNET=0x34a646ab823e3352291f74c886cf624c9ebc1dea
NEXT_PUBLIC_ROTA_DEPLOY_BLOCK_MAINNET=22409417

# The mainnet chain must also be configured, or mainnet is not offered.
NEXT_PUBLIC_ARC_MAINNET_CHAIN_ID=5042
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# ---- Sign-in (Circle user-controlled wallets) ----
# Public app id. Circle Console > Wallets > User Controlled > Configurator.
NEXT_PUBLIC_CIRCLE_APP_ID=
# Google OAuth client id. Google Cloud Console > Credentials > OAuth 2.0.
# Omit to hide "Continue with Google" and keep email sign-in only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# CIRCLE_API_KEY is deliberately NOT here and NEVER NEXT_PUBLIC_.
# It is a server-only secret; see .env.example at the repo root.

# ---- Automatic payouts (optional) ----
# A funded wallet that calls the permissionless disburse() when a round falls
# due, so no member has to press anything. It has NO special power: Rota has no
# owner and no admin, disburse always pays members[cycleIndex] rather than the
# caller, and no member ever grants this address an allowance. Proven in
# contracts/test/Relayer.t.ts. Leave it unset and circles work exactly as
# before — members settle their own rounds from the circle page.
#
# Server-only. Never NEXT_PUBLIC_: it is a private key.
RELAYER_PRIVATE_KEY=
# Warn in the logs below this many USDC. Gas on Arc is paid in USDC, so this is
# the same balance the ERC-20 reports. Default 1.
RELAYER_MIN_USDC=1
# Vercel sends `Authorization: Bearer $CRON_SECRET` to the cron route. Without
# it the route refuses every request, including Vercel's — it fails closed,
# because an open endpoint lets anyone burn the relayer's gas budget.
CRON_SECRET=
