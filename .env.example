# ---- contracts (hardhat) ----

# Deployer key. Never commit the real .env
PRIVATE_KEY=

# Arc mainnet. Not hardcoded anywhere in the repo; arcMainnet is only
# registered as a Hardhat network once both of these are set.
ARC_MAINNET_CHAIN_ID=5042
ARC_MAINNET_RPC_URL=https://arc-mainnet.g.alchemy.com/v2/YOUR_KEY
# fallback: https://rpc.mainnet.arc.io

# Optional: read USDC balance for this address instead of deriving it from
# PRIVATE_KEY when running scripts/probe.ts
ADDRESS=

# ---- web (next.js) ----
# Same mainnet values, exposed to the browser. Copy into web/.env.local
NEXT_PUBLIC_ARC_MAINNET_CHAIN_ID=5042
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://arc-mainnet.g.alchemy.com/v2/YOUR_KEY
# fallback: https://rpc.mainnet.arc.io
