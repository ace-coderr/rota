# ---- contracts (hardhat) ----

# Deployer key. Never commit the real .env
PRIVATE_KEY=

# Arc mainnet. Deliberately not hardcoded anywhere in the repo; arcMainnet is
# only registered as a network once both of these are set.
ARC_MAINNET_RPC_URL=
ARC_MAINNET_CHAIN_ID=

# Optional: read USDC balance for this address instead of deriving it from
# PRIVATE_KEY when running scripts/probe.ts
ADDRESS=

# ---- web (next.js) ----
# Same mainnet values, exposed to the browser. Copy into web/.env.local
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=
NEXT_PUBLIC_ARC_MAINNET_CHAIN_ID=
